# Required: OpenAI-compatible chat completions endpoint credentials.
# For Intern-S1:
#   OPENAI_API_KEY=<your-intern-s1-token, no Bearer prefix>
#   LLM_API_BASE=https://chat.intern-ai.org.cn/api/v1/chat/completions
#   MODEL_NAME=intern-s1
OPENAI_API_KEY=
LLM_API_BASE=https://api.openai.com/v1/chat/completions
MODEL_NAME=gpt-4o-mini

# Optional: separate credentials for the LLM judge used by `evaluation.evaluate --llm-judge`.
# JUDGE_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=
